{
  "expo": {
    "name": "PAZ Shop",
    "slug": "paz-shop",
    "version": "1.0.0",
    "scheme": "pazshop",
    "orientation": "portrait",
    "description": "The PAZ Thriving Tribe digital product shop.",
    "runtimeVersion": "1.0.0",
